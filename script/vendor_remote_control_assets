#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/../app/assets/web/remote_control/vendor"

fetch() {
  local url="$1" target="$2" expected="$3"
  curl -fsSL "$url" -o "$target"
  local actual
  actual="$(shasum -a 256 "$target" | cut -d' ' -f1)"
  if [ "$actual" != "$expected" ]; then
    echo "checksum mismatch for $target" >&2
    echo "  expected $expected" >&2
    echo "  actual   $actual" >&2
    rm -f "$target"
    exit 1
  fi
  echo "verified $target"
}

fetch https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js \
  xterm.js 1f991ac3b4b283ebf96e60ae23a00a52765dd3a2e46fa6fdda9f1aab032f7495
fetch https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css \
  xterm.css ba8e6985669488981ccf40c0cefe3aba80722cb6c92de7ad628b0bd717faf2b6
fetch https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js \
  addon-fit.js bdaefa370b1bfc42ee88d46fe6072400902a4d4b2d45cd93438dda9b23c97089
fetch https://cdn.jsdelivr.net/npm/@xterm/addon-web-links@0.11.0/lib/addon-web-links.js \
  addon-web-links.js f230a6c8211ce4614dda5441f27b603c7c1ca95151a655bc0efac6377ee643f0
fetch https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/LICENSE \
  LICENSE-xterm b569f629d00f2626a8100df2a1798210535621e42164dfd426a6fe5aac7b0ccd
